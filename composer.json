{
  "name": "tnegeli/m2clitools",
  "description": "Some nice commands to cleanup media files and tables on production systems",
  "type": "magento2-module",
  "license": [
    "MIT"
  ],
  "support": {
    "issues": "https://github.com/ThomasNegeli/M2CliTools/issues"
  },
  "keywords": [
    "magento",
    "cli"
  ],
  "require": {
    "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
    "magento/framework": "^103.0.7",
    "magento/module-catalog": "^104.0.7",
    "magento/module-indexer": "^100.4.7",
    "magento/module-swatches": "^100.4.7"
  },
  "autoload": {
    "psr-4": {
      "Tnegeli\\M2CliTools\\": ""
    },
    "files": [
      "registration.php"
    ]
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
